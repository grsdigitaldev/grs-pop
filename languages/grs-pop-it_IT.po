msgid "At least one way to close is required: the close button will be shown."
msgstr ""
"Serve almeno un modo per chiudere: verrà mostrato il pulsante di chiusura."

#: assets/js/builder.js:3
msgid "After a form is sent"
msgstr "Dopo l'invio di un form"

#: assets/js/builder.js:3
msgid "Close the popup after a few seconds"
msgstr "Chiudi il popup dopo qualche secondo"

#: assets/js/builder.js:3
msgid "Keep it open"
msgstr "Lascialo aperto"

