msgid "After scrolling the page"
msgstr "Dopo lo scorrimento della pagina"

#: assets/js/builder.js:3
msgid "Page scrolled"
msgstr "Pagina scorsa"

#: assets/js/builder.js:3
msgid "When the visitor is about to leave (exit intent)"
msgstr "Quando il visitatore sta per uscire (exit intent)"

